[Unit]
Description=Project 1 web application
After=network-online.target
Wants=network-online.target

[Service]
User=appsvc
Group=appsvc
WorkingDirectory=/opt/project1-app/repo/app
EnvironmentFile=/etc/project1-app.env
ExecStart=/usr/bin/env node src/server.js
Restart=always
RestartSec=3
TimeoutStopSec=30
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
