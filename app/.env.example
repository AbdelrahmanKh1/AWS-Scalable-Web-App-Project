# Copy to .env for local development (never commit .env).
# Load it with: node --env-file=.env src/server.js
PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=change-me

# On AWS, use Secrets Manager instead of DB_USER / DB_PASSWORD:
# DB_SECRET_ARN=arn:aws:secretsmanager:<region>:<account-id>:secret:<name>
# AWS_REGION=<region>

# Enable for RDS, and point DB_SSL_CA_PATH at the RDS CA bundle:
# DB_SSL=true
# DB_SSL_CA_PATH=/opt/project1-app/certs/rds-global-bundle.pem
